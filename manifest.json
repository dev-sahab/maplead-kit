{
  "manifest_version": 3,
  "name": "MapLead Kit - Local Business Lead Tool",
  "version": "1.0.0",
  "description": "Scrape local business leads from Google Maps search results with scrolling, filtering, and clean CSV export.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.google.com/maps/*",
    "https://maps.google.com/*"
  ],
  "action": {
    "default_popup": "src/ui/popup.html"
  },
  "icons": {
    "16": "src/ui/icons/icon-16.png",
    "48": "src/ui/icons/icon-48.png",
    "128": "src/ui/icons/icon-128.png"
  },
  "background": {
    "service_worker": "src/ui/background.js"
  }
}
